{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/loop-builder",
  "version": "0.1.0",
  "title": "BW Loop Builder",
  "category": "blockwriter",
  "icon": "grid-view",
  "description": "Repeats a custom layout for each post in a query. Compose the layout with inner blocks such as post title, featured image, and excerpt.",
  "example": {},
  "keywords": [
    "loop",
    "query",
    "posts",
    "archive",
    "template",
    "repeater"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "postType": {
      "type": "string",
      "default": "post"
    },
    "perPage": {
      "type": "number",
      "default": 6
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "gap": {
      "type": "number",
      "default": 24
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "DESC"
    },
    "categoryIds": {
      "type": "array",
      "default": []
    },
    "tagIds": {
      "type": "array",
      "default": []
    },
    "authorId": {
      "type": "number",
      "default": 0
    },
    "offset": {
      "type": "number",
      "default": 0
    },
    "includeIds": {
      "type": "array",
      "default": []
    },
    "excludeIds": {
      "type": "array",
      "default": []
    },
    "ignoreSticky": {
      "type": "boolean",
      "default": true
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}