{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/woo-product-price",
  "version": "0.1.0",
  "title": "BW Product Price",
  "category": "blockwriter",
  "icon": "money",
  "description": "Displays the price of a WooCommerce product. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "product",
    "price",
    "shop",
    "cost"
  ],
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "textAlign": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 0
    },
    "priceColor": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}