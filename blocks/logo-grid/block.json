{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/logo-grid",
  "version": "0.1.0",
  "title": "BW Logo Grid",
  "category": "blockwriter",
  "icon": "grid-view",
  "description": "A responsive grid of client or partner logos with a grayscale hover effect.",
  "example": {},
  "keywords": [
    "logo",
    "logos",
    "grid",
    "clients",
    "partners",
    "trust"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "logos": {
      "type": "array",
      "default": []
    },
    "logoColumns": {
      "type": "number",
      "default": 4
    },
    "grayscale": {
      "type": "boolean",
      "default": true
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}