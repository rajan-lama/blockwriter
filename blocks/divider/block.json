{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/divider",
  "version": "0.1.0",
  "title": "BW Divider",
  "category": "blockwriter",
  "icon": "minus",
  "description": "A horizontal divider to visually separate content sections.",
  "example": {},
  "keywords": [
    "divider",
    "separator",
    "horizontal rule"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "dividerStyle": {
      "type": "string",
      "default": "solid"
    },
    "dividerColor": {
      "type": "string",
      "default": "#d1d5db"
    },
    "dividerWeight": {
      "type": "number",
      "default": 2
    },
    "dividerWidth": {
      "type": "number",
      "default": 100
    },
    "dividerAlign": {
      "type": "string",
      "default": "center"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}