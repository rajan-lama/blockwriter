{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/text",
  "version": "0.1.0",
  "title": "BW Text",
  "category": "blockwriter",
  "icon": "editor-paragraph",
  "description": "Paragraph text with full typography controls.",
  "example": {},
  "keywords": [
    "text",
    "paragraph",
    "content"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": "p,div,span",
      "default": ""
    },
    "tagType": {
      "type": "string",
      "default": "p"
    },
    "contentColor": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": ""
    },
    "fontWeight": {
      "type": "string",
      "default": ""
    },
    "textAlign": {
      "type": "string",
      "default": ""
    },
    "textTransform": {
      "type": "string",
      "default": ""
    },
    "letterSpacing": {
      "type": "string",
      "default": ""
    },
    "lineHeight": {
      "type": "string",
      "default": ""
    },
    "dropCap": {
      "type": "boolean",
      "default": false
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}