{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/woo-cart",
  "version": "0.1.0",
  "title": "BW Cart",
  "category": "blockwriter",
  "icon": "cart",
  "description": "Displays the WooCommerce cart form, totals, and cross-sells. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "cart",
    "shop",
    "store",
    "checkout"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}