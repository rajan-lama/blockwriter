{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/alert",
  "version": "0.1.0",
  "title": "BW Alert",
  "category": "blockwriter",
  "icon": "warning",
  "description": "A notice box for info, success, warning, and error messages.",
  "example": {},
  "keywords": [
    "alert",
    "notice",
    "message",
    "info",
    "warning"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": ".bw-alert-content",
      "default": ""
    },
    "alertType": {
      "type": "string",
      "default": "info"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}