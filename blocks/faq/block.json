{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/faq",
  "version": "0.1.0",
  "title": "BW FAQ",
  "category": "blockwriter",
  "icon": "editor-help",
  "description": "A list of questions and answers rendered as accessible accordion items.",
  "example": {},
  "keywords": [
    "faq",
    "accordion",
    "questions",
    "help"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "faqItems": {
      "type": "array",
      "default": [
        {
          "question": "",
          "answer": ""
        }
      ]
    },
    "firstOpen": {
      "type": "boolean",
      "default": false
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}