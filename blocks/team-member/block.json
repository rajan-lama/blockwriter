{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/team-member",
  "version": "0.1.0",
  "title": "BW Team Member",
  "category": "blockwriter",
  "icon": "groups",
  "description": "A team member profile with photo, name, role, and short bio.",
  "example": {},
  "keywords": [
    "team",
    "member",
    "person",
    "profile",
    "staff"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "memberName": {
      "type": "string",
      "default": ""
    },
    "memberRole": {
      "type": "string",
      "default": ""
    },
    "memberBio": {
      "type": "string",
      "default": ""
    },
    "avatarUrl": {
      "type": "string",
      "default": ""
    },
    "avatarId": {
      "type": "number",
      "default": 0
    },
    "avatarAlt": {
      "type": "string",
      "default": ""
    },
    "memberAlign": {
      "type": "string",
      "default": "center"
    },
    "avatarShape": {
      "type": "string",
      "default": "round"
    },
    "hasShadow": {
      "type": "boolean",
      "default": false
    },
    "tagType": {
      "type": "string",
      "default": "div"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}