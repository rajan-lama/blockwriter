{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/cta",
  "version": "0.1.0",
  "title": "BW Call To Action",
  "category": "blockwriter",
  "icon": "megaphone",
  "description": "A prominent call-to-action banner with heading, text, and button content.",
  "example": {},
  "keywords": [
    "cta",
    "call to action",
    "banner",
    "convert"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "ctaAlign": {
      "type": "string",
      "default": "center"
    },
    "ctaBackground": {
      "type": "string",
      "default": "#4f46e5"
    },
    "ctaTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "tagType": {
      "type": "string",
      "default": "div"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}