{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/tabs",
  "version": "0.1.0",
  "title": "BW Tabs",
  "category": "blockwriter",
  "icon": "table-row-after",
  "description": "Switchable tab panels for organizing content.",
  "example": {},
  "keywords": [
    "tabs",
    "tabbed",
    "panels",
    "content"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "tabItems": {
      "type": "array",
      "default": [
        {
          "label": "",
          "content": ""
        }
      ]
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}