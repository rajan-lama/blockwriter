{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/comparison-table",
  "version": "0.1.0",
  "title": "BW Comparison Table",
  "category": "blockwriter",
  "icon": "editor-table",
  "description": "Compare products or options across a list of features with check and cross markers.",
  "example": {},
  "keywords": [
    "comparison",
    "table",
    "pricing",
    "matrix",
    "features"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "featureColLabel": {
      "type": "string",
      "default": "Features"
    },
    "products": {
      "type": "array",
      "default": [
        {
          "name": "",
          "price": ""
        },
        {
          "name": "",
          "price": ""
        }
      ]
    },
    "rows": {
      "type": "array",
      "default": []
    },
    "highlightIndex": {
      "type": "number",
      "default": -1
    },
    "accentColor": {
      "type": "string",
      "default": "#4f46e5"
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}