{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/woo-mini-cart",
  "version": "0.1.0",
  "title": "BW Mini Cart",
  "category": "blockwriter",
  "icon": "cart",
  "description": "Displays a collapsible WooCommerce mini cart that stays in sync with cart updates. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "cart",
    "mini cart",
    "shop",
    "store"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "toggleText": {
      "type": "string",
      "default": ""
    },
    "showToggle": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "openByDefault": {
      "type": "boolean",
      "default": false
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}