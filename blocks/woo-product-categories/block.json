{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/woo-product-categories",
  "version": "0.1.0",
  "title": "BW Product Categories",
  "category": "blockwriter",
  "icon": "grid-view",
  "description": "Displays WooCommerce product categories with optional thumbnails. Requires WooCommerce.",
  "example": {},
  "keywords": [
    "woocommerce",
    "product",
    "categories",
    "shop",
    "grid"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "layout": {
      "type": "string",
      "default": "grid"
    },
    "columns": {
      "type": "number",
      "default": 3
    },
    "hierarchical": {
      "type": "boolean",
      "default": false
    },
    "hideEmpty": {
      "type": "boolean",
      "default": true
    },
    "showCount": {
      "type": "boolean",
      "default": true
    },
    "showThumbnail": {
      "type": "boolean",
      "default": true
    },
    "orderBy": {
      "type": "string",
      "default": "name"
    },
    "order": {
      "type": "string",
      "default": "ASC"
    },
    "limit": {
      "type": "number",
      "default": 0
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}