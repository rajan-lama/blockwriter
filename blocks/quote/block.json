{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/quote",
  "version": "0.1.0",
  "title": "BW Quote",
  "category": "blockwriter",
  "icon": "format-quote",
  "description": "A styled quotation with citation and alignment controls.",
  "example": {},
  "keywords": [
    "quote",
    "blockquote",
    "citation",
    "testimonial"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "content": {
      "type": "string",
      "source": "html",
      "selector": "p",
      "default": ""
    },
    "citation": {
      "type": "string",
      "source": "html",
      "selector": "cite",
      "default": ""
    },
    "quoteAlign": {
      "type": "string",
      "default": ""
    },
    "quoteSize": {
      "type": "string",
      "default": "medium"
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}