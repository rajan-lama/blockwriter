{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockwriter/feature",
	"version": "0.1.0",
	"title": "BW Feature",
	"category": "blockwriter",
	"icon": "star-filled",
	"description": "An icon, title, description, and optional link presented as a feature tile.",
	"example": {},
	"keywords": ["feature", "benefit", "icon", "highlight", "service"],
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"attributes": {
		"icon": {
			"type": "string",
			"default": "check"
		},
		"showIcon": {
			"type": "boolean",
			"default": true
		},
		"iconColor": {
			"type": "string",
			"default": "#4f46e5"
		},
		"iconBackground": {
			"type": "string",
			"default": "#eef2ff"
		},
		"iconSize": {
			"type": "number",
			"default": 24
		},
		"iconPosition": {
			"type": "string",
			"default": "top"
		},
		"iconShape": {
			"type": "string",
			"default": "rounded"
		},
		"contentAlign": {
			"type": "string",
			"default": "left"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		},
		"linkText": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"linkNewTab": {
			"type": "boolean",
			"default": false
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"extraClass": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "blockwriter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
