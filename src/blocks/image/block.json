{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockwriter/image",
  "version": "0.1.0",
  "title": "BW Image",
  "category": "blockwriter",
  "icon": "format-image",
  "description": "An image with sizing, cropping, alignment, and caption controls.",
  "example": {},
  "keywords": ["image", "picture", "photo", "media"],
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "attributes": {
    "url": {
      "type": "string",
      "default": ""
    },
    "id": {
      "type": "number",
      "default": 0
    },
    "alt": {
      "type": "string",
      "default": ""
    },
    "imageWidth": {
      "type": "number",
      "default": ""
    },
    "imageHeight": {
      "type": "number",
      "default": ""
    },
    "objectFit": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "number",
      "default": ""
    },
    "imageAlign": {
      "type": "string",
      "default": ""
    },
    "caption": {
      "type": "string",
      "source": "html",
      "selector": "figcaption",
      "default": ""
    },
    "htmlId": {
      "type": "string",
      "default": ""
    },
    "extraClass": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "blockwriter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}
