{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blockwriter/related-posts",
	"version": "0.1.0",
	"title": "BW Related Posts",
	"category": "blockwriter",
	"icon": "postList",
	"description": "Displays posts related to the current entry by shared taxonomy terms.",
	"example": {},
	"keywords": ["related", "posts", "similar", "more like this"],
	"usesContext": ["postId", "postType"],
	"supports": {
		"html": false,
		"align": ["wide", "full"]
	},
	"attributes": {
		"perPage": {
			"type": "number",
			"default": 3
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"orderBy": {
			"type": "string",
			"default": "date"
		},
		"order": {
			"type": "string",
			"default": "DESC"
		},
		"showFeaturedImage": {
			"type": "boolean",
			"default": true
		},
		"imageSize": {
			"type": "string",
			"default": "medium_large"
		},
		"showExcerpt": {
			"type": "boolean",
			"default": false
		},
		"excerptLength": {
			"type": "number",
			"default": 20
		},
		"showDate": {
			"type": "boolean",
			"default": true
		},
		"readMoreText": {
			"type": "string",
			"default": ""
		},
		"htmlId": {
			"type": "string",
			"default": ""
		},
		"extraClass": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "blockwriter",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
